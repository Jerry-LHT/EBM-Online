    "GRADEMethodDecision": {
      "additionalProperties": false,
      "properties": {
        "authoritative_sources": {
          "items": {
            "$ref": "#/$defs/MethodologyReference"
          },
          "title": "Authoritative Sources",
          "type": "array"
        },
        "decision": {
          "title": "Decision",
          "type": "string"
        },
        "decision_id": {
          "title": "Decision Id",
          "type": "string"
        },
        "protocol_alignment": {
          "$ref": "#/$defs/ProtocolAlignment"
        },
        "provenance": {
          "items": {
            "$ref": "#/$defs/Provenance"
          },
          "title": "Provenance",
          "type": "array"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "topic": {
          "title": "Topic",
          "type": "string"
        }
