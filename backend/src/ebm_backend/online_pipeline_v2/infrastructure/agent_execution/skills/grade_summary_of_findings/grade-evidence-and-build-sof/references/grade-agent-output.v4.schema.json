      "type": "object"
    },
    "GRADEUpgradeAssessment": {
      "additionalProperties": false,
      "properties": {
        "domain": {
          "$ref": "#/$defs/GRADEUpgradeDomain"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
