{
  "$defs": {
    "AbsoluteEffectCalculation": {
      "additionalProperties": false,
      "description": "Inputs for a supported deterministic absolute-effect derivation.\n\nAbsence means that the scenario was reported upstream or could not be\nderived by a supported calculator. It is not an error or a professional\ninsufficiency judgement.",
      "properties": {
        "baseline_risk": {
          "title": "Baseline Risk",
          "type": "number"
        },
        "confidence_interval_lower": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Confidence Interval Lower"
        },
        "confidence_interval_upper": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Confidence Interval Upper"
        },
        "display_scale": {
          "title": "Display Scale",
          "type": "number"
        },
        "effect_estimate": {
          "title": "Effect Estimate",
          "type": "number"
        },
        "measure": {
          "title": "Measure",
          "type": "string"
        }
      },
      "required": [
        "measure",
        "baseline_risk",
        "effect_estimate",
        "confidence_interval_lower",
        "confidence_interval_upper",
        "display_scale"
      ],
      "title": "AbsoluteEffectCalculation",
      "type": "object"
    },
    "AbsoluteEffectScenario": {
      "additionalProperties": false,
      "properties": {
        "absolute_difference": {
          "$ref": "#/$defs/EffectPresentation"
        },
        "baseline_basis": {
          "title": "Baseline Basis",
          "type": "string"
        },
        "calculation": {
          "anyOf": [
            {
              "$ref": "#/$defs/AbsoluteEffectCalculation"
            },
            {
              "type": "null"
            }
          ]
        },
        "comparator_effect": {
          "$ref": "#/$defs/EffectPresentation"
        },
        "intervention_effect": {
          "$ref": "#/$defs/EffectPresentation"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "provenance": {
          "items": {
            "$ref": "#/$defs/Provenance"
          },
          "title": "Provenance",
          "type": "array"
        }
      },
      "required": [
        "label",
        "comparator_effect",
        "intervention_effect",
        "absolute_difference",
        "baseline_basis",
        "calculation",
        "provenance"
      ],
      "title": "AbsoluteEffectScenario",
      "type": "object"
    },
    "ArtifactIssue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "provenance": {
          "items": {
            "$ref": "#/$defs/Provenance"
          },
          "title": "Provenance",
          "type": "array"
        },
        "severity": {
          "$ref": "#/$defs/IssueSeverity"
        }
      },
      "required": [
        "code",
        "message",
        "severity",
        "provenance"
      ],
      "title": "ArtifactIssue",
      "type": "object"
    },
    "Certainty": {
      "enum": [
        "high",
        "moderate",
        "low",
        "very_low"
      ],
      "title": "Certainty",
      "type": "string"
    },
    "EffectPresentation": {
      "additionalProperties": false,
      "properties": {
        "confidence_interval_lower": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Confidence Interval Lower"
        },
        "confidence_interval_unavailable_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Confidence Interval Unavailable Reason"
        },
        "confidence_interval_upper": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Confidence Interval Upper"
        },
        "estimate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Estimate"
        },
        "measure": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Measure"
        },
        "narrative": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Narrative"
        },
        "provenance": {
          "items": {
            "$ref": "#/$defs/Provenance"
          },
          "title": "Provenance",
          "type": "array"
        },
        "status": {
          "$ref": "#/$defs/EffectStatus"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unit"
        }
      },
      "required": [
        "status",
        "measure",
        "estimate",
        "confidence_interval_lower",
        "confidence_interval_upper",
        "confidence_interval_unavailable_reason",
        "unit",
        "narrative",
        "provenance"
      ],
      "title": "EffectPresentation",
      "type": "object"
    },
    "EffectStatus": {
      "enum": [
        "estimated",
        "not_estimable",
        "not_reported"
      ],
      "title": "EffectStatus",
      "type": "string"
    },
    "GRADEConcern": {
      "enum": [
        "not_serious",
        "serious",
        "very_serious",
        "extremely_serious"
      ],
      "title": "GRADEConcern",
      "type": "string"
    },
    "GRADEDomain": {
      "enum": [
        "risk_of_bias",
        "inconsistency",
        "indirectness",
        "imprecision",
        "publication_bias"
      ],
      "title": "GRADEDomain",
      "type": "string"
    },
    "GRADEDomainJudgement": {
      "additionalProperties": false,
      "properties": {
        "concern": {
          "$ref": "#/$defs/GRADEConcern"
        },
        "domain": {
          "$ref": "#/$defs/GRADEDomain"
        },
        "downgrade_levels": {
          "title": "Downgrade Levels",
          "type": "integer"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "provenance": {
          "items": {
            "$ref": "#/$defs/Provenance"
          },
          "title": "Provenance",
          "type": "array"
        }
      },
      "required": [
        "domain",
        "concern",
        "downgrade_levels",
        "explanation",
        "provenance"
