      "required": [
        "evidence_body_id",
        "synthesis_analysis_ids",
        "status",
        "initial_certainty",
        "initial_certainty_basis",
        "domains",
        "upgrades",
        "explanation",
        "issues"
      ],
      "title": "GradedGRADEAssessmentDraft",
      "type": "object"
    },
    "IssueSeverity": {
      "enum": [
        "warning",
        "error"
      ],
      "title": "IssueSeverity",
      "type": "string"
    },
    "MethodologyReference": {
      "additionalProperties": false,
