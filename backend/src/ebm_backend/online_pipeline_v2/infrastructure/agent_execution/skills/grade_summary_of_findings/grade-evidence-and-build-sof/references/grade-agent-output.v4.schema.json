      "required": [
        "domain",
        "judgement",
        "upgrade_levels",
        "explanation",
        "provenance"
      ],
      "title": "GRADEUpgradeAssessment",
      "type": "object"
    },
    "GRADEUpgradeDomain": {
      "enum": [
        "large_effect",
        "dose_response",
        "opposing_plausible_residual_confounding"
      ],
      "title": "GRADEUpgradeDomain",
      "type": "string"
    },
    "GRADEUpgradeJudgement": {
      "enum": [
        "not_applicable",
        "not_present",
        "present"
      ],
      "title": "GRADEUpgradeJudgement",
      "type": "string"
    },
    "GradeSummaryOfFindingsDraft": {
      "additionalProperties": false,
      "properties": {
        "evidence_profiles": {
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/GradedGRADEAssessmentDraft"
              },
              {
                "$ref": "#/$defs/NoEvidenceGRADEProfileDraft"
              }
            ]
          },
          "title": "Evidence Profiles",
          "type": "array"
        },
        "method_decisions": {
          "items": {
            "$ref": "#/$defs/GRADEMethodDecision"
          },
          "title": "Method Decisions",
          "type": "array"
        },
        "schema_version": {
          "const": "grade-sof-draft.v4",
          "title": "Schema Version",
          "type": "string"
        },
        "summary_of_findings": {
          "items": {
            "$ref": "#/$defs/SummaryOfFindingsTableDraft"
          },
          "title": "Summary Of Findings",
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "method_decisions",
        "evidence_profiles",
        "summary_of_findings"
      ],
      "title": "GradeSummaryOfFindingsDraft",
      "type": "object"
    },
    "GradedGRADEAssessmentDraft": {
      "additionalProperties": false,
      "properties": {
        "domains": {
          "items": {
            "$ref": "#/$defs/GRADEDomainJudgement"
          },
          "title": "Domains",
          "type": "array"
        },
        "evidence_body_id": {
          "title": "Evidence Body Id",
          "type": "string"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "initial_certainty": {
          "$ref": "#/$defs/Certainty"
        },
        "initial_certainty_basis": {
          "title": "Initial Certainty Basis",
          "type": "string"
        },
        "issues": {
          "items": {
            "$ref": "#/$defs/ArtifactIssue"
          },
          "title": "Issues",
          "type": "array"
        },
        "status": {
          "const": "graded",
          "title": "Status",
          "type": "string"
        },
        "synthesis_analysis_ids": {
          "items": {
            "type": "string"
          },
          "title": "Synthesis Analysis Ids",
          "type": "array"
        },
        "upgrades": {
          "items": {
            "$ref": "#/$defs/GRADEUpgradeAssessment"
          },
          "title": "Upgrades",
          "type": "array"
        }
