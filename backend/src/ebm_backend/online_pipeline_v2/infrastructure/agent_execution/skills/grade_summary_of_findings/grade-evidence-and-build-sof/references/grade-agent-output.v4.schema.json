        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "source_type": {
          "title": "Source Type",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "source_type",
        "locator",
        "excerpt"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "SummaryOfFindingsRowDraft": {
      "additionalProperties": false,
      "properties": {
        "absolute_effects": {
          "items": {
            "$ref": "#/$defs/AbsoluteEffectScenario"
          },
