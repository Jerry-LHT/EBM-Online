          "type": "null"
        }
      ]
    },
    "blocker": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Blocker"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/ArtifactIssue"
      },
      "title": "Issues",
      "type": "array"
    },
    "status": {
      "enum": [
        "completed",
        "blocked"
      ],
      "title": "Status",
      "type": "string"
    },
    "warnings": {
      "items": {
        "type": "string"
